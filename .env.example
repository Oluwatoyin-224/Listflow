# Frontend environment variables (required)
# These are pre-populated in the .env file — do not change them unless you
# are pointing the app at a different Supabase project.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Edge function secrets (set these in the Supabase dashboard, NOT in frontend code)
# MAILGUN_API_KEY — your Mailgun API key
# MAILGUN_DOMAIN — your Mailgun sending domain (e.g. mail.example.com)
# MAILGUN_FROM — the from address for order emails (e.g. orders@mail.example.com)
